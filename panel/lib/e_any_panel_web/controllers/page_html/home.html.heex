<Layouts.app flash={@flash}>
  <section aria-labelledby="entry-title">
    <h1 id="entry-title" class="text-3xl font-semibold tracking-tight">Çalışma alanını aç</h1>
    <p class="mt-4 mb-8 leading-relaxed">Notlarına, kayıtlı bağlantılarına, kasana ve araçlarına eriş.</p>
    <a id="enter-workspace" href={~p"/login"} class="btn btn-primary">Panele Giriş Yap <.icon name="hero-arrow-right" class="size-4" /></a>
  </section>
</Layouts.app>
